{
  "name": "sydia-video",
  "version": "1.0.0",
  "description": "Sydia video compositions built with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/animation-utils": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/effects": "4.0.541",
    "@remotion/elevenlabs": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/gsap": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/paths": "4.0.541",
    "@remotion/sfx": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts SydiaPromo out/sydia-promo.mp4",
    "render:showcase": "remotion render src/index.ts SydiaShowcase out/sydia-showcase.mp4",
    "render:showcase-square": "remotion render src/index.ts SydiaShowcaseSquare out/sydia-showcase-square.mp4",
    "render:seller": "remotion render src/index.ts SydiaSeller out/sydia-seller.mp4",
    "music": "python3 -I scripts/make-music.py public/music/sydia-anthem.wav",
    "music:showcase": "python3 -I scripts/make-showcase-music.py public",
    "music:seller": "python3 -I scripts/make-seller-music.py public/music/sydia-seller.wav",
    "voiceover:seller": "node scripts/make-seller-voiceover.mjs",
    "sfx:seller": "node scripts/make-seller-sfx.mjs",
    "render:titipan": "remotion render src/index.ts TitipanTelur out/titipan-telur.mp4",
    "music:titipan": "python3 scripts/make-titipan-music.py public/music/titipan-telur.wav",
    "music:sibuk": "python3 scripts/make-sibuk-music.py",
    "render:sibuk": "remotion render src/index.ts SibukSeharian out/sibuk-seharian.mp4",
    "voiceover:sibuk": "node scripts/make-sibuk-voiceover.mjs",
    "sfx:sibuk": "node scripts/make-sibuk-sfx.mjs",
    "art:sibuk": "python3 scripts/make-sibuk-art.py",
    "render:fallacy": "remotion render src/index.ts CumaSepuluhMenit out/cuma-sepuluh-menit.mp4",
    "voiceover:fallacy": "node scripts/make-fallacy-voiceover.mjs",
    "sfx:fallacy": "node scripts/make-fallacy-sfx.mjs",
    "music:fallacy": "python3 scripts/make-fallacy-music.py",
    "art:fallacy": "python3 scripts/make-fallacy-art.py",
    "voiceover:titipan": "node scripts/make-titipan-voiceover.mjs",
    "sfx:titipan": "node scripts/make-titipan-sfx.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
